---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';

// Solo proyectos publicados, en el orden que fija el dueño (desempate por título)
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'es'),
);

interface Group {
  id: string;
  eyebrow: string;
  title: string;
  items: CollectionEntry<'projects'>[];
}

// Experiencia profesional primero; las secciones vacías no se muestran
const groups: Group[] = [
  {
    id: 'profesionales',
    eyebrow: 'Trabajo',
    title: 'Experiencia profesional',
    items: projects.filter((p) => p.data.kind === 'professional'),
  },
  {
    id: 'personales',
    eyebrow: 'Personal',
    title: 'Proyectos personales',
    items: projects.filter((p) => p.data.kind === 'personal'),
  },
].filter((group) => group.items.length > 0);
---

<BaseLayout title={`${site.name} · ${site.title}`} description={`Proyectos de ${site.name}, ${site.title}.`}>
  <Hero />
  <div id="proyectos" class="container sections">
    {
      groups.length > 0 ? (
        groups.map((group) => (
          <section aria-labelledby={`${group.id}-title`}>
            <header class="section-header reveal">
              <p class="eyebrow">{group.eyebrow}</p>
              <h2 id={`${group.id}-title`}>{group.title}</h2>
            </header>
            <div class="grid">
              {group.items.map((project) => (
                <ProjectCard project={project} />
              ))}
            </div>
          </section>
        ))
      ) : (
        <p class="empty">Todavía no hay proyectos publicados.</p>
      )
    }
  </div>
  <Contact />
</BaseLayout>

<style>
  .sections {
    display: grid;
    gap: var(--space-24);
  }

  .section-header {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  h2 {
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.5rem);
    font-weight: 600;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    grid-auto-flow: dense;
    gap: var(--space-6);
  }

  .empty {
    color: var(--color-muted);
  }
</style>
