---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ProjectLinks from './ProjectLinks.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const detailUrl = `/projects/${project.id}/`;
const badge = data.kind === 'professional' ? `${data.company} · ${data.period}` : 'Proyecto personal';
---

<article class:list={['card', 'reveal', { featured: data.featured }]}>
  <div class="cover">
    <Image
      src={data.cover.src}
      alt={data.cover.alt}
      widths={[480, 960, 1440]}
      sizes={data.featured ? '(min-width: 64rem) 66vw, 100vw' : '(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw'}
    />
  </div>
  <div class="body">
    <p class="badge">{badge}</p>
    <h3>
      <!-- El enlace del título cubre toda la tarjeta (ver .stretched::after) -->
      <a href={detailUrl} class="stretched">
        {data.title}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </h3>
    <p class="summary">{data.summary}</p>
    <ul class="stack" aria-label="Tecnologías">
      {data.stack.map((tech) => <li>{tech}</li>)}
    </ul>
    <div class="links">
      <ProjectLinks links={data.links} source={`src/content/projects/${project.id}`} />
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.03), transparent 40%), var(--color-surface);
    overflow: hidden;
    transition:
      transform 0.35s var(--ease-out),
      border-color 0.35s,
      box-shadow 0.35s;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: rgb(124 140 255 / 0.45);
    box-shadow:
      0 0 0 1px rgb(124 140 255 / 0.15),
      0 20px 50px -20px var(--color-accent-glow);
  }

  .cover {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .card:hover .cover img {
    transform: scale(1.04);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    flex: 1;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-subtle);
  }

  h3 {
    font-size: var(--font-size-xl);
    font-weight: 600;
  }

  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .arrow {
    display: inline-block;
    margin-left: var(--space-1);
    color: var(--color-accent);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.3s,
      transform 0.3s var(--ease-out);
  }

  .card:hover .arrow {
    opacity: 1;
    transform: none;
  }

  .summary {
    flex: 1;
    color: var(--color-muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stack li {
    padding: 0.125rem var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: rgb(255 255 255 / 0.03);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  /* Los enlaces externos quedan por encima del enlace que cubre la tarjeta */
  .links {
    position: relative;
    z-index: 2;
  }

  .links:empty {
    display: none;
  }

  @media (min-width: 64rem) {
    .featured {
      grid-column: span 2;
      grid-row: span 2;
    }

    .featured h3 {
      font-size: 2rem;
    }

    .featured .summary {
      font-size: var(--font-size-lg);
    }
  }
</style>
