---
import type { CollectionEntry } from 'astro:content';
import { assertNoPlaceholders } from '../lib/placeholders';

type Video = CollectionEntry<'projects'>['data']['videos'][number];

interface Props {
  videos: Video[];
  // Identifica al proyecto en el mensaje de error si quedan marcadores pendientes
  source: string;
}

const { videos, source } = Astro.props;

assertNoPlaceholders(
  source,
  videos.flatMap((video) => (video.source === 'link' ? [video.url] : [])),
);
---

{
  videos.length > 0 && (
    <section class="videos" aria-labelledby="videos-title">
      <h2 id="videos-title">Videos</h2>
      <div class="list">
        {videos.map((video) => (
          <figure class="video">
            {video.source === 'file' && (
              // Sin autoplay: el visitante decide cuándo reproducir (FR-006)
              <video controls muted playsinline preload="metadata" poster={video.poster}>
                <source src={video.path} type="video/mp4" />
              </video>
            )}
            {video.source === 'youtube' && (
              <div class="embed">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${video.videoId}`}
                  title={video.title}
                  loading="lazy"
                  allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              </div>
            )}
            {video.source === 'link' && (
              <a class="external" href={video.url} target="_blank" rel="noopener noreferrer">
                Ver video <span aria-hidden="true">↗</span>
              </a>
            )}
            <figcaption>{video.title}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )
}

<style>
  .videos {
    display: grid;
    gap: var(--space-6);
  }

  h2 {
    font-size: var(--font-size-xl);
    font-weight: 600;
  }

  .list {
    display: grid;
    gap: var(--space-8);
  }

  .video {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  video,
  .embed {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
  }

  .embed {
    aspect-ratio: 16 / 9;
  }

  .embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .external {
    justify-self: start;
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-weight: 600;
  }

  .external:hover {
    border-color: var(--color-accent);
  }

  figcaption {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }
</style>
