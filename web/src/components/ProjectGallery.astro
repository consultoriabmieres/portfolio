---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

type Media = CollectionEntry<'projects'>['data']['images'][number];

interface Props {
  images: Media[];
}

const { images } = Astro.props;
---

{
  images.length > 0 && (
    <section class="gallery" aria-labelledby="gallery-title">
      <h2 id="gallery-title">Imágenes</h2>
      <div class:list={['grid', { single: images.length === 1 }]}>
        {images.map((image) => (
          // Cada imagen abre su archivo original en una pestaña nueva
          <a href={image.src.src} target="_blank" rel="noopener noreferrer" class="item">
            <Image src={image.src} alt={image.alt} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" />
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .gallery {
    display: grid;
    gap: var(--space-6);
  }

  h2 {
    font-size: var(--font-size-xl);
    font-weight: 600;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-4);
  }

  .grid.single {
    grid-template-columns: 1fr;
  }

  .item {
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: border-color 0.3s;
  }

  .item:hover {
    border-color: rgb(124 140 255 / 0.45);
  }

  .item img {
    width: 100%;
    transition: transform 0.6s var(--ease-out);
  }

  .item:hover img {
    transform: scale(1.03);
  }
</style>
